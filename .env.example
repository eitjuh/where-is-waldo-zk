# Demo server (verifier + static UI)
HOST=127.0.0.1
PORT=4174

# Local prove daemon (run: pnpm real:prove:daemon)
ZK_WALDO_PROVER_HOST=127.0.0.1
ZK_WALDO_PROVER_PORT=4175
ZK_WALDO_PREFER_LOCAL_PROVER=1

# Proving policy
ZK_WALDO_ALLOW_COORDINATE_WITNESS=0
ZK_WALDO_TRUST_REMOTE=0
ZK_WALDO_PROVE_RATE_LIMIT=6

# Model signing (maintainers only; private key is gitignored)
# ZK_WALDO_RELEASE_KEY=models/release.pem
