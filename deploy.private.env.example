# Copy to deploy.private.env (gitignored) and fill in your values.
# Used by scripts/vps/deploy.sh — never commit deploy.private.env.

# SSH target (Tailscale MagicDNS, bastion, or other private host)
ZK_WALDO_SSH_REMOTE=deploy@YOUR_HOST

# Public demo hostname (Cloudflare DNS → same tunnel as your other sites)
ZK_WALDO_PUBLIC_HOST=waldo.example.com

# Local port when using: ssh -N -L <port>:127.0.0.1:4174 $ZK_WALDO_SSH_REMOTE
ZK_WALDO_SSH_TUNNEL_PORT=4174
